#ifndef __parameters
#define __parameters

#include <typeinfo>
#include <iostream>
#include <cstdlib>
#include <cxxabi.h>

#define data_type1 double
#define data_type2 double
#define qs_max_steps 100 // define maximum depth for quick sort algorithm (see explicit_quick_sort kernel in quick_sort.cu)

template <class T> T epsilon () {
  int status;
  std::string Tname = typeid(T).name();
  char *demangled_name = abi::__cxa_demangle(Tname.c_str(), NULL, NULL, &status);
  if(status == 0) {
    Tname = demangled_name;
    std::free(demangled_name);
  }

  if (Tname == "float") return 1E-8;
  if (Tname == "double") return 1E-12;
  std::cout << "unknown type for template. Please add precision value in file CPU/headers/parameters" << std::endl;
  exit(0);
}

#endif
