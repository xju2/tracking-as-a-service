name: "DoubleMetricLearning"
backend: "python"

input [
  {
    name: "FEATURES"
    data_type: TYPE_FP32
    dims: [ -1, 44 ]
  }
]

output [
  {
    name: "LABELS"
    data_type: TYPE_INT64
    dims: [ -1 ]
  }
]


instance_group [
  {
    count: 1
    kind: KIND_GPU
   }
]

parameters: {
  key: "auto_cast",
  value: {string_value: "False"}
}

parameters: {
  key: "compiling",
  value: {string_value: "False"}
}

parameters: {
  key: "use_dpw",
  value: {string_value: "False"}
}

# Version 2 only: graph_segment backend (cc, cc_walk, cc_bestpred_walk, cc_junction_removal)
# and its cuts as JSON. Each backend uses only the cuts it knows; see graph_segment's README.
parameters: {
  key: "segment_backend",
  value: {string_value: "cc_walk"}
}

parameters: {
  key: "segment_cuts",
  value: {string_value: "{\"cc_cut\": 0.01, \"th_min\": 0.1, \"th_add\": 0.6}"}
}

# Sum GNN messages in a fixed order instead of with CUDA atomics, so the same event always
# gives the same tracks, at some latency cost. Versions 1 and 2.
parameters: {
  key: "deterministic",
  value: {string_value: "False"}
}
